{
  "expo": {
    "name": "Dictionary Mobile App",
    "slug": "dictionary-mobile-app",
    "scheme": "dictionaryapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mchiir.dictionaryapp"
    },
    "android": {
      "package": "com.mchiir.dictionaryapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
